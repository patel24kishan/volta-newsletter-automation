# Copy to .env for a checkout. Never commit .env.
# An installed copy takes these from the host's config (or a .env in its data folder) instead;
# the full list, with what each does, is src/install/env.ts.

# ---- What the person running the newsletter sets ----

# Email platform: Mailchimp. The API key's suffix (-us21) names the data centre.
# The audience (list) holds the recipients; the newsletter never sees addresses.
# Leave all three empty to run without Mailchimp (approve saves the file only).
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_REPLY_TO=
MAILCHIMP_FROM_NAME=Volta

# Only if a Slack channel is a source: a bot token (xoxb-) with channels:history, channels:read, users:read.
SLACK_BOT_TOKEN=

# Set to 1 only for a deliberate live run. Everything else is dry-run.
ALLOW_LIVE=0

# Where the database, built drafts and the alerts log live. Empty means the OS's per-user data
# folder (%LOCALAPPDATA%\volta-newsletter, ~/Library/Application Support/volta-newsletter, or
# ~/.local/share/volta-newsletter). A checkout started through bin/mcp-server.mjs uses ./out.
VOLTA_NEWSLETTER_HOME=

# ---- Maintainer and demo settings ----

# Your own sources, timezone and holidays; the packaged config/default.json when empty.
CONFIG_PATH=

# Each may be placed on its own; otherwise they sit inside VOLTA_NEWSLETTER_HOME.
DATABASE_PATH=
OUT_DIR=

# Run as if it were this date and time (ISO 8601 with offset). Same as --now=... on any command.
DEMO_NOW=
# 1 to allow a live run while DEMO_NOW is set, for a deliberate live demo.
ALLOW_LIVE_WITH_DEMO_CLOCK=

# ---- The retired Slack review surface (Socket Mode); not used by the MCP server ----
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BADER_USER_ID=
SLACK_MAINTAINER_USER_ID=
SLACK_SOCIAL_CHANNEL_ID=

# ---- Reserved for sources not yet built (Google Keep, config sheet) ----
GOOGLE_SERVICE_ACCOUNT_FILE=
CONFIG_SHEET_ID=
