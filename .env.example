# Copy to .env for local development. Never commit .env.
# Production values live in the hosting platform's secret store (see PLAN.md 5.5).

# Set to 1 only for a deliberate live run. Everything else is dry-run.
ALLOW_LIVE=0

# Optional: run the pipeline as if it were this date and time (ISO 8601 with offset).
# Same as passing --now=... on any command. Leave empty for the real clock.
DEMO_NOW=

# Local storage (SQLite) for development and dry-run.
DATABASE_PATH=./out/newsletter.sqlite

# Config sheet (source URLs, member watchlist, send day, holidays, alert recipients).
CONFIG_SHEET_ID=

# Google service account with read-only access to the config sheet, events calendar,
# and the transcripts Drive folder. Path to a JSON key file, git-ignored.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Slack app (reminder DM, selection, alerts). Socket Mode: needs both a bot token (xoxb-)
# and an app-level token (xapp-) with connections:write. No public URL required.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_BADER_USER_ID=
SLACK_MAINTAINER_USER_ID=
SLACK_SOCIAL_CHANNEL_ID=

# LLM (Anthropic API, or Vertex AI if chosen in PLAN.md 5.4).
ANTHROPIC_API_KEY=

# Email platform: Mailchimp (see PLAN.md 5.6). The API key's suffix (-us21) names the data centre.
# The audience (list) holds the recipients; the pipeline never sees addresses.
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
MAILCHIMP_FROM_NAME=Volta
MAILCHIMP_REPLY_TO=
